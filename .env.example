# Neon Postgres connection string (pooled URL is fine)
DATABASE_URL=

# Signs the /admin session cookie. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Used only by `npm run db:set-admin-passwords`. Do not put real values in git.
# Not needed on Vercel after the hashes are stored in Neon.
# ADMIN_TED_PASSWORD=
# ADMIN_ALEX_PASSWORD=

# Vercel Blob token. Required on Vercel so /admin can upload files.
# Created when you add a Blob store to the Vercel project.
BLOB_READ_WRITE_TOKEN=

# Optional. Used for absolute social-preview URLs. Vercel sets this automatically.
# NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app
