# Neon Postgres connection string (pooled URL is fine)
DATABASE_URL=

# Shared secret for the /admin studio desk. Pick a long random phrase.
ADMIN_SECRET=

# Vercel Blob token. Required on Vercel so /admin can upload files.
# Created when you add a Blob store to the Vercel project.
BLOB_READ_WRITE_TOKEN=

# Optional. Used for absolute social-preview URLs. Vercel sets this automatically.
# NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app
